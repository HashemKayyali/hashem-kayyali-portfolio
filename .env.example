# Copy to .env.local. These are SERVER-ONLY values: never prefix them with VITE_.
# Accounts may be created later; blank provider keys keep the Studio in setup mode.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if the new sb_secret_ key is unavailable:
# SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_PASSWORD=8080
# Generate at least32random characters; do not reuse the admin password here.
ADMIN_SESSION_SECRET=
# Optional public site origin, used for route metadata when deploying:
VITE_SITE_URL=
