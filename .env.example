# Copy to .env.local. These are SERVER-ONLY values: never prefix them with VITE_ and never commit them.
# Blank provider keys keep the Studio in setup mode (empty public collections, admin disabled).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if the new sb_secret_ key is unavailable:
# SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Studio admin. There is no default password. Generate all three with:
#   npm run studio:password -- --session --totp
# ADMIN_PASSWORD_HASH is a scrypt hash (the plaintext password is never stored anywhere).
# A plaintext ADMIN_PASSWORD variable is refused: if present, admin stays disabled.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Required in production (VERCEL_ENV=production); optional locally. Base32, 128+ bits.
ADMIN_TOTP_SECRET=

# Optional public site origin, used for route metadata when building:
VITE_SITE_URL=

# Optional, not a secret: serve verified built-in project media from Cloudinary (see docs/engineering/CLOUDINARY-MIGRATION.md).
# Leave empty to serve the local files exactly as before.
VITE_MEDIA_CDN=
