{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:light",
  "outputDirectory": "dist-light-preview",
  "functions": {
    "api/studio.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)/:path(.*)",
      "destination": "/:locale/:path",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|ar|de|fr|es|creative)/:path(.*)",
      "destination": "/preview/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}