{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:light",
  "outputDirectory": "dist-light-preview",
  "functions": {"api/studio.ts": {"maxDuration": 30}},
  "redirects": [
    {"source": "/", "destination": "/preview/en/", "permanent": false},
    {"source": "/:locale(en|ar|de|fr|es)/:path*", "destination": "/preview/:locale/:path*", "permanent": false}
  ],
  "rewrites": [
    {"source": "/preview/:path*", "destination": "/preview/index.html"}
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
