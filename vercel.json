{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:light",
  "outputDirectory": "dist-light-preview",
  "functions": {
    "api/studio.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)/:path(.*)",
      "destination": "/:locale/:path",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|ar|de|fr|es|creative)/:path(.*)",
      "destination": "/preview/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(projects|images|brand|engineering-process|experience|v2-icons|v2-media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
