{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:light",
  "outputDirectory": "dist-light-preview",
  "functions": {
    "api/studio.ts": {
      "maxDuration": 30
    },
    "api/analytics.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/index\\.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/preview/:path((?:creative/)?(?:en|ar|de|fr|es)(?:/.*)?)/index\\.html",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/:path((?:creative/)?(?:en|ar|de|fr|es)(?:/.*)?)/index\\.html",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)/:path(.*[^/])",
      "destination": "/:locale/:path/",
      "permanent": true
    },
    {
      "source": "/preview/:locale(en|ar|de|fr|es|creative)/:path(.*)",
      "destination": "/:locale/:path",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|fr|es|creative)",
      "destination": "/:locale/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|fr|es)/:page(about|projects|experience|skills|contact|gallery|journal|admin)",
      "destination": "/:locale/:page/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|fr|es)/projects/:project(eventies|glitzz-lab|umniah-youthconnect|terminal-nfc|bike-tower|basket-beats|vr-cycling|bike-land-trainer|financial-operations|outreach-automation|traffic-flow-analytics)",
      "destination": "/:locale/projects/:project/",
      "permanent": true
    },
    {
      "source": "/creative/:locale(en|ar|de|fr|es)",
      "destination": "/creative/:locale/",
      "permanent": true
    },
    {
      "source": "/creative/:locale(en|ar|de|fr|es)/:page(about|projects|experience|skills|contact|gallery|journal|admin)",
      "destination": "/creative/:locale/:page/",
      "permanent": true
    },
    {
      "source": "/creative/:locale(en|ar|de|fr|es)/projects/:project(eventies|glitzz-lab|umniah-youthconnect|terminal-nfc|bike-tower|basket-beats|vr-cycling|bike-land-trainer|financial-operations|outreach-automation|traffic-flow-analytics)",
      "destination": "/creative/:locale/projects/:project/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/insights(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/images/hashem-profile.webp",
      "headers": [{ "key": "Content-Type", "value": "image/jpeg" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(projects|covers|images|brand|engineering-process|experience|v2-icons|v2-media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
