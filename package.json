{
  "name": "hashem-kayyali-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr seo/entry-server.tsx --outDir dist-ssr",
    "prerender": "node seo/prerender.mjs",
    "validate:seo": "node scripts/validate-seo.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.25",
    "lenis": "^1.3.26",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
